# Copy this file to .env and adjust if needed. Defaults below match docker-compose.yml.

DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
POSTGRES_DB=dosje_db
POSTGRES_USER=dosje_user
POSTGRES_PASSWORD=dosje_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

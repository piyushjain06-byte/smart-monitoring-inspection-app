# Copy this file to .env

DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Phase 4.5 (Channels) / Phase 4.7 (Celery) — both need Redis reachable
# at this URL. Default assumes a local Redis on the standard port. If you
# don't have Redis running yet, leave this as-is: the app still starts and
# works fine (poll-on-load + manual "Run AI Analysis" button), it just
# won't get the live push / scheduled runs until Redis is available.
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND default to REDIS_URL above —
# only set these if you want Celery on a different Redis DB/instance.
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Everything else (Postgres settings) is commented out in settings.py until
# the Postgres+PostGIS phase.

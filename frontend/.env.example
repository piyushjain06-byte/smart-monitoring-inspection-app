# Copy this file to frontend/.env

VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Phase 4.5 — optional. If unset, this is derived automatically from
# VITE_API_BASE_URL above (same host, ws:// instead of http://). Only set
# this explicitly if your WebSocket endpoint lives somewhere different
# (e.g. daphne on a different port than a proxied /api).
# VITE_WS_BASE_URL=ws://127.0.0.1:8000
